#!/bin/sh
set -e

SOURCES=/etc/apt/sources.list.d/ticpu.sources

if [ "$1" = configure ] && [ ! -e "$SOURCES" ]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    case "${VERSION_CODENAME:-}" in
    bookworm|trixie|noble|resolute)
        cat > "$SOURCES" <<SOURCESEOF
Types: deb
URIs: https://apt.ticpu.net
Suites: ${VERSION_CODENAME}
Components: main
Signed-By: /usr/share/keyrings/ticpu-archive-keyring.gpg
SOURCESEOF
        ;;
    *)
        echo "ticpu-archive-keyring: apt.ticpu.net carries no suite for '${VERSION_CODENAME:-unknown}'." >&2
        echo "The key is installed; write $SOURCES yourself if another suite fits." >&2
        ;;
    esac
fi

exit 0
